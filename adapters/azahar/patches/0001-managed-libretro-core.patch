+bool ConfigureManagedStorage() {
+    settings.managed_storage_ready = false;
+    auto target = LibRetro::GetSaveDir();
+    if (target.empty())
+        return false;
+    namespace fs = std::filesystem;
+    std::error_code error;
+    const auto base = fs::canonical(fs::u8path(target), error);
+    if (error)
+        return false;
+    const auto expected = base / "Azahar";
+    const auto resolved = fs::weakly_canonical(expected, error);
+    if (error || resolved != expected)
+        return false;
+    if (!target.ends_with("/"))
+        target += "/";
+    target += "Azahar/";
+    // Reject redirection before creation and before SetUserPath's fallback path.
+    if (!FileUtil::CreateFullPath(target) || !FileUtil::IsDirectory(target))
+        return false;
+    FileUtil::SetUserPath(target);
+    settings.managed_storage_ready =
+        FileUtil::GetUserPath(FileUtil::UserPath::UserDir) == target;
+    return settings.managed_storage_ready;
+}
