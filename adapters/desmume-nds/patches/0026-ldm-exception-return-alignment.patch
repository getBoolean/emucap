--- /dev/null
+++ b/desmume/src/frontend/posix/cli/ldm_exception_return.cpp
@@ -0,0 +1,49 @@
+#include "armcpu.h"
+#include "MMU.h"
+#include "instructions.h"
+#include "SPU.h"
+#include "render3D.h"
+#include <cstdio>
+#include <cstdlib>
+
+// Frontend services are unused by these instruction-level checks.
+volatile bool execute = false;
+SoundInterface_struct* SNDCoreList[] = {&SNDDummy, nullptr};
+GPU3DInterface* core3DList[] = {&gpu3DNull, nullptr};
+void* createThread_gdb(void (*)(void*), void*) { std::abort(); }
+void joinThread_gdb(void*) { std::abort(); }
+
+static u32 savedPc;
+static u32 read32(void*, u32) { return savedPc; }
+int main()
+{
+    armcpu_memory_iface memory = {};
+    memory.read32 = read32;
+    int failures = 0;
+    const u32 forms[] = {0xe8d48000, 0xe9d48000, 0xe8548000, 0xe9548000,
+                         0xe8f48000, 0xe9f48000, 0xe8748000, 0xe9748000};
+    for (int proc = 0; proc < 2; ++proc)
+    for (u32 opcode : forms)
+    for (u32 thumb : {0u, 1u})
+    for (u32 target : {0x037fe700u, 0x037fe701u, 0x037fe702u, 0x037fe703u})
+    {
+        armcpu_t& cpu = proc ? NDS_ARM7 : NDS_ARM9;
+        cpu.proc_ID = proc;
+        cpu.CPSR.val = 0x92;
+        cpu.SPSR.val = 0x6000001f | (thumb << 5);
+        cpu.mem_if = &memory;
+        cpu.R[4] = 0x02001000;
+        cpu.runToRet = false;
+        savedPc = target;
+        arm_instructions_set[proc][INSTRUCTION_INDEX(opcode)](opcode);
+        const u32 expected = target & (thumb ? 0xfffffffeu : 0xfffffffcu);
+        if (cpu.R[15] != expected || cpu.next_instruction != expected || cpu.CPSR.val != (0x6000001f | (thumb << 5)))
+        {
+            fprintf(stderr, "ARM%d opcode=%08x T=%u target=%08x expected=%08x actual=%08x cpsr=%08x\n",
+                    proc ? 7 : 9, opcode, thumb, target, expected, cpu.next_instruction, cpu.CPSR.val);
+            ++failures;
+        }
+    }
+    printf("LDM exception return: %d failures across 128 cases\n", failures);
+    return failures ? 1 : 0;
+}
