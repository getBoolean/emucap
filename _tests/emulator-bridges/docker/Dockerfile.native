FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential git curl ca-certificates python3 python3-venv gdb \
    xvfb xauth mesa-vulkan-drivers libvulkan1 libasound2-dev libpulse0 libudev1 \
    libgl1 libx11-6 libxext6 libxrandr2 libxcursor1 libxi6 libxinerama1 \
    libwayland-client0 libxkbcommon0 libfontconfig1 libxrender1 libxcb1 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/emucap-venv \
    && /opt/emucap-venv/bin/pip install --no-cache-dir Pillow==11.3.0 \
    && useradd --create-home emucap
ENV PATH=/opt/emucap-venv/bin:$PATH
